# Copy this file to .env and fill in your real values.
# Find credentials in the Box Developer Console:
# https://cloud.app.box.com/developers/console

# CCG app credentials (Configuration tab)
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret

# Your enterprise ID (profile icon > Copy Enterprise ID)
BOX_ENTERPRISE_ID=your_enterprise_id

# Folder where each new hire's workspace is created.
# 0 = the Service Account's root folder (fine for getting started).
# For admin-visible workspaces, create a "New Hires" folder, add the
# Service Account as co-owner, and set that folder's ID here.
ONBOARDING_ROOT_FOLDER_ID=0
